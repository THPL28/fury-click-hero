{
  "name": "fury-click-hero-api",
  "version": "1.0.0",
  "description": "Enterprise-ready async API with Express, BullMQ, Redis, Zod, and Clean Architecture.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node scripts/start.cjs",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/interface-adapters/workers/index.ts",
    "worker:start": "node scripts/worker.cjs",
    "lint": "eslint . --ext .ts,.js --max-warnings=0",
    "test": "npm run build && node --test tests/**/*.test.js",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prepare": "node scripts/prepare.cjs",
    "commitlint": "commitlint --edit",
    "release": "release-please release-pr --config-file .release-please-config.json --manifest-file .release-please-manifest.json"
  },
  "keywords": [
    "clean-architecture",
    "express",
    "bullmq",
    "redis",
    "zod",
    "typescript",
    "enterprise",
    "semver"
  ],
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "axios": "^1.7.2",
    "bullmq": "^5.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.7",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.8.0",
    "typescript": "^5.4.5",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "release-please": "^17.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.29.0"
  }
}
